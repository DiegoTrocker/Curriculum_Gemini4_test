# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, canonical SEO URLs, and sitemaps.
APP_URL="MY_APP_URL"

# GITHUB_USERNAME: Optional backend override for the GitHub account synced on the public site.
GITHUB_USERNAME=

# GITHUB_TOKEN: Optional personal access token for higher GitHub REST API rate limits (server-side only).
GITHUB_TOKEN=

# ADMIN_PASSCODE: Optional server-side passcode for the separate /admin publishing console.
# Leave unset to claim a passcode interactively on first run at /admin.
ADMIN_PASSCODE=

# LOCAL_ADMIN_ONLY: Set to "true" when self-hosting on a private network/machine to block /admin
# and all write APIs from non-localhost / open-internet requests.
LOCAL_ADMIN_ONLY=false
